
:root {
  color-scheme: dark;

  /* Brand colors */
  --ra-bg: #07111F;
  --ra-bg-elevated: #0B1730;
  --ra-cyan: #42E8F5;
  --ra-violet: #8B7CFF;
  --ra-text: #F7FAFF;
  --ra-text-muted: #B5C3D8;

  /* Risk indicators */
  --ra-safe: #32D583;
  --ra-warning: #FFBF69;
  --ra-danger: #FF5D73;

  /* Surfaces */
  --ra-glass: rgba(16, 34, 59, 0.78);
  --ra-glass-border: rgba(151, 190, 230, 0.18);
  --ra-shadow: 0 18px 55px rgba(0, 0, 0, 0.25);
  --ra-radius: 20px;

  /* Layout and motion */
  --ra-space: 24px;
  --ra-transition: 220ms ease;
  --ra-focus: 0 0 0 3px rgba(66, 232, 245, 0.65);
}

/* Optional light theme */
[data-theme="light"] {
  color-scheme: light;
  --ra-bg: #F3F6FC;
  --ra-bg-elevated: #FFFFFF;
  --ra-text: #142238;
  --ra-text-muted: #4D5E75;
  --ra-glass: rgba(255, 255, 255, 0.92);
  --ra-glass-border: rgba(35, 55, 85, 0.15);
  --ra-shadow: 0 12px 35px rgba(20, 35, 60, 0.09);
}

html {
  background: var(--ra-bg);
}

body {
  margin: 0;
  color: var(--ra-text);
  background: var(--ra-bg);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  line-height: 1.6;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  transition:
    transform var(--ra-transition),
    border-color var(--ra-transition),
    background-color var(--ra-transition);
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: none;
  box-shadow: var(--ra-focus);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
